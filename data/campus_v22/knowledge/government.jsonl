{"category": "ai_usage", "confidence": "high", "content_sha256": "bea588e3286efa69cfeb8be8fe398cabb93633f2a8dc8462029faf8e7ed8223d", "id": "digital-open-data-001", "last_verified_at": "2026-08-24", "license": "Public Data License 1.0", "license_url": "https://www.digital.go.jp/resources/open_data", "publisher": "デジタル庁", "retrieved_at": "2026-08-24T12:12:44+00:00", "source": "デジタル庁", "source_priority": 50, "source_type": "official_government", "source_url": "https://www.digital.go.jp/resources/open_data", "sub_category": "open_data", "text": "オープンデータに関する決定文書や各種資料等について掲載しています。 官民データ活用推進基本法(平成28年法律第103号)において、国及び地方公共団体はオープンデータに取り組むことが義務付けられました。オープンデータへの取組により、国民参加・官民協働の推進を通じた諸課題の解決、経済活性化、行政の高度化・効率化等が期待されています。", "title": "オープンデータ|デジタル庁", "university_name": null, "university_slug": null, "university_specific": false}
